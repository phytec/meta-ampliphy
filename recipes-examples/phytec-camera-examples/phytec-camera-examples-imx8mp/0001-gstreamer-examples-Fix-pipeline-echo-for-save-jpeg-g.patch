Subject: [PATCH 1/3] gstreamer-examples: Fix pipeline echo for save jpeg gst
 pipeline
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Upstream-Status: Inappropriate [PHYTEC specific]

Signed-off-by: Stefan Riedmüller <s.riedmueller@phytec.de>
---
 phytec-gstreamer-examples/tools/func.sh | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/phytec-gstreamer-examples/tools/func.sh b/phytec-gstreamer-examples/tools/func.sh
index a12ee7b63527..609727067d18 100644
--- a/phytec-gstreamer-examples/tools/func.sh
+++ b/phytec-gstreamer-examples/tools/func.sh
@@ -337,7 +337,7 @@ create_gst_save_jpeg_pipeline() {
 	if [ -n "${GST_CONV}" ] ; then
 		echo "    ${GST_CONV} ! \\"
 	fi
-	echo "    ${ENCODING}"
+	echo "    ${ENCODING} ! \\"
 	echo "    ${SINK}"
 	echo ""
 
